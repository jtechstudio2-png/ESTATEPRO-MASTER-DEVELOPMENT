{
  "name": "@estatepro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage --exclude 'test/**/*.performance.test.ts' --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "test:performance": "vitest run test/listings.performance.test.ts test/location.performance.test.ts test/media.performance.test.ts --reporter=default --reporter=json --outputFile.json=test-results/vitest-performance.json",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi/generate.js",
    "db:types": "kysely-codegen --dialect postgres --camel-case --date-parser string --numeric-parser string --exclude-pattern \"public.{*_20[0-9][0-9][0-9][0-9],*_default,spatial_ref_sys,geography_columns,geometry_columns}\" --out-file src/database/schema.ts",
    "provision-company": "node dist/cli/provision-company.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "22.2.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "kysely-codegen": "0.20.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
