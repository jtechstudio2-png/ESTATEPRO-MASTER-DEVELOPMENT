# EstatePro API configuration. Copy to .env for local development; never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Runtime connection: must log in as (or as a member of) estatepro_app, which is subject to RLS.
DATABASE_URL=postgres://estatepro_app:change-me@localhost:5432/estatepro
# Identity resolution connection: estatepro_auth.
AUTH_DATABASE_URL=postgres://estatepro_auth:change-me@localhost:5432/estatepro
DATABASE_POOL_MAX=10

# Managed identity provider (ADR-001). Values come from the chosen IdP (GitHub issue #6).
OIDC_ISSUER=https://your-tenant.idp.example/
OIDC_AUDIENCE=estatepro-api
OIDC_JWKS_URL=https://your-tenant.idp.example/.well-known/jwks.json
OIDC_PROVIDER=your-idp
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk,fido
STEP_UP_MAX_AGE_SECONDS=900

# Only for the provision-company command (platform staff).
# PLATFORM_DATABASE_URL=postgres://estatepro_platform:change-me@localhost:5432/estatepro
