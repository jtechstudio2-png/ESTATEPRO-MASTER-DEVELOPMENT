# EstatePro API configuration. Copy to .env for local development; never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Runtime connection: must log in as (or as a member of) estatepro_app, which is subject to RLS.
DATABASE_URL=postgres://estatepro_app:change-me@localhost:5432/estatepro
# Identity resolution connection: estatepro_auth.
AUTH_DATABASE_URL=postgres://estatepro_auth:change-me@localhost:5432/estatepro
DATABASE_POOL_MAX=10

# Managed identity provider (ADR-001). Values come from the chosen IdP (GitHub issue #6).
OIDC_ISSUER=https://your-tenant.idp.example/
OIDC_AUDIENCE=estatepro-api
OIDC_JWKS_URL=https://your-tenant.idp.example/.well-known/jwks.json
OIDC_PROVIDER=your-idp
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk,fido
STEP_UP_MAX_AGE_SECONDS=900

# Object storage (ADR-005 M-D1). Cloudflare R2 (primary):
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  STORAGE_REGION=auto
# AWS S3 (fallback): leave STORAGE_ENDPOINT unset and set STORAGE_REGION to the bucket's region.
# Local development: SeaweedFS (see README) with STORAGE_FORCE_PATH_STYLE=true.
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=auto
STORAGE_BUCKET=estatepro-media-dev
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_DOWNLOAD_URL_TTL_SECONDS=900

# Worker only (node dist/worker/main.js): malware scanner and the queue connection.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
# Also used by the provision-company command (platform staff).
# PLATFORM_DATABASE_URL=postgres://estatepro_platform:change-me@localhost:5432/estatepro
