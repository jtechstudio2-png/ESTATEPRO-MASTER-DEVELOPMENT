# EstatePro web app (apps/web). Copy to .env.local for `pnpm dev`.
# Server-side only: none of these values reach the browser except the map URLs.

# Public origin of this app (no trailing slash). Must be https in production.
WEB_ORIGIN=http://localhost:3100
# The EstatePro API, reached from the server only (the browser talks to /bff).
API_BASE_URL=http://localhost:3000

# Session store: the estatepro_web role created by migration 0020.
WEB_DATABASE_URL=postgres://estatepro_web:change-me@localhost:5432/estatepro
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts tokens at rest.
WEB_SESSION_KEY=
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# OpenID Connect provider (ADR-001). Authorization Code + PKCE.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=estatepro-web
# Omit for a public client (PKCE only).
# OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email offline_access
# Some providers need the API audience in the authorisation request.
# OIDC_AUDIENCE=estatepro-api
# Plain-http issuer for local development only (refused in production unless loopback).
OIDC_ALLOW_INSECURE=false

# Self-hosted basemap (W-D4): PMTiles archive and glyphs on our own host
# (scripts/build-basemap.sh). Empty = plain background map; pins still work.
MAP_TILES_URL=
MAP_GLYPHS_URL=

# Content-Security-Policy additions (src/middleware.ts): the media store
# (signed photo and upload URLs) and the tile host, as origins.
MEDIA_ORIGIN=
MAP_TILES_ORIGIN=
