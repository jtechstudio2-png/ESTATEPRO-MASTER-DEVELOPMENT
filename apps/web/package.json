{
  "name": "@estatepro/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @performance",
    "test:e2e:performance": "playwright test --grep @performance",
    "messages:check": "node scripts/check-messages.mjs",
    "api:types": "openapi-typescript ../api/openapi.json -o src/lib/api-schema.ts --root-types --root-types-no-schema-prefix",
    "predev": "node scripts/copy-map-assets.mjs",
    "prebuild": "node scripts/copy-map-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "maplibre-gl": "6.16.0",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "jose": "6.2.15",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "stylelint": "17.16.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
